# Copy to .env and adjust if needed. Streamlit doesn't auto-load .env files,
# so either `export $(cat .env | xargs)` before running, or set these in
# your shell profile.

# "allosaurus" (default, GitHub-hosted model, works behind most corporate
# filtering) or "wav2vec2" (heavier, more accurate, needs huggingface.co)
PHONEME_BACKEND=allosaurus

# "espeak" (default, zero extra downloads, more robotic) or "piper"
# (nicer neural voice, needs huggingface.co)
TTS_BACKEND=espeak

# Local Ollama server, same as your other projects
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral

# Only read when TTS_BACKEND=piper
PIPER_VOICE=en_US-lessac-medium
PIPER_VOICE_DIR=./voices
